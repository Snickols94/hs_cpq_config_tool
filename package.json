{
  "name": "cpq-configurator",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "convex dev",
    "build": "vite build",
    "preview": "vite preview",
    "predev": "convex dev --until-success && convex dashboard",
    "logs": "convex logs",
    "typecheck": "tsc -p convex && tsc -p src",
    "lint": "npm run typecheck && eslint . --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "convex": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
}
